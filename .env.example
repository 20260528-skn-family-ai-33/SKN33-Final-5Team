# LENS 4th-project style: edit this one Ollama endpoint in the root .env.
A4B_LLM_BASE_URL=http://127.0.0.1:11434/v1
# A4B_LLM_BASE_URL=https://YOUR_POD_ID-11434.proxy.runpod.net/v1
A4B_LLM_MODEL=qwen3:8b-q4_K_M
A4B_VERIFIER_MODEL=qwen3.5:4b
A4B_VERIFIER_MODE=shadow

HOST=127.0.0.1
PORT=3041
EASYFLOW_DATA_DIR=data-local-integration
# Only if your Ollama endpoint requires bearer authentication:
# A4B_LLM_API_KEY=

# Per model call and whole design-worker time budgets (seconds / milliseconds)
A4B_MAIN_TIMEOUT_S=180
A4B_DESIGN_TIMEOUT_MS=600000

# Parser handoff: prepare models explicitly and set absolute cache paths.
A4B_PDF_PARSER_MODE=standard
A4B_PDF_DEVICE=auto
PDF_LIGHTON_ENABLED=0
A4B_PDF_TIMEOUT_MS=300000
# A4B_PDF_ARTIFACTS_DIR=/absolute/path/to/data/pdf-models/docling
# A4B_PDF_OCR_MODEL_DIR=/absolute/path/to/data/pdf-models/docling/EasyOcr

# Document inspection and parser routing. Set 0 to use the legacy upload path.
A4B_DOCUMENT_ROUTING=1
A4B_DOCUMENT_PYTHON=Backend/.venv-document-analysis/bin/python
A4B_DOCUMENT_TIMEOUT_MS=300000
A4B_DOCUMENT_MAX_SUPPLEMENTS=16
# Each neural engine can use its own environment; model downloads are offline.
# EASYFLOW_DOCLING_PYTHON=Backend/.venv-docling/bin/python
# A4B_MINERU_PYTHON=/absolute/path/to/mineru-environment/bin/python
# MINERU_HOME=/absolute/path/to/data/document-runtime/mineru
# MINERU_MODEL_SMALL_BACKEND=torch
# MINERU_MODEL_VLM_ENGINE=llama-cpp
# A4B_PADDLE_PYTHON=/absolute/path/to/paddle-environment/bin/python
# A4B_PADDLE_MODEL_DIR=/absolute/path/to/data/document-runtime/paddlex/official_models
# A4B_PADDLE_DEVICE=cpu
# A4B_LAYOUT_MODEL_DIR=/absolute/path/to/PP-DocLayout_plus-L
# PADDLE_PDX_CACHE_HOME=/absolute/path/to/data/document-runtime/paddlex
# HF_HOME=/absolute/path/to/data/document-runtime/huggingface
# A4B_RHWP=/absolute/path/to/rhwp
# A4B_LIBREOFFICE=/absolute/path/to/soffice
