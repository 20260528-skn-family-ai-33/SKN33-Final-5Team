# Single .env at the repository root. npm run dev, npm start and scripts/run-configured.mjs all read it;
# exported variables take precedence. (Previously Frontend/.env was read by npm run dev/start.)

# LENS 4th-project style: edit this one Ollama endpoint in the root .env.
A4B_LLM_BASE_URL=http://127.0.0.1:11434/v1
# A4B_LLM_BASE_URL=https://YOUR_POD_ID-11434.proxy.runpod.net/v1
A4B_LLM_MODEL=qwen3:8b-q4_K_M
A4B_VERIFIER_MODEL=qwen3.5:4b
# shadow verifies on every request; defer records the same input and leaves the model call to
# scripts/run-deferred-verifications.py (faster responses, verdicts filled in later).
A4B_VERIFIER_MODE=shadow

HOST=127.0.0.1
PORT=3041
EASYFLOW_DATA_DIR=data-local-integration
# Only if your Ollama endpoint requires bearer authentication:
# A4B_LLM_API_KEY=

# Per model call and whole design-worker time budgets (seconds / milliseconds)
A4B_MAIN_TIMEOUT_S=180
A4B_DESIGN_TIMEOUT_MS=600000

# Parser handoff: prepare models explicitly and set absolute cache paths.
A4B_PDF_PARSER_MODE=standard
A4B_PDF_DEVICE=auto
PDF_LIGHTON_ENABLED=0
A4B_PDF_TIMEOUT_MS=300000
# A4B_PDF_ARTIFACTS_DIR=/absolute/path/to/data/pdf-models/docling
# A4B_PDF_OCR_MODEL_DIR=/absolute/path/to/data/pdf-models/docling/EasyOcr

# Document inspection and parser routing. Set 0 to use the legacy upload path.
A4B_DOCUMENT_ROUTING=1
# Unset: the server picks Backend/.venv-document-analysis (bin/python or Scripts\python.exe) per OS.
# A4B_DOCUMENT_PYTHON=Backend/.venv-document-analysis/bin/python
A4B_DOCUMENT_TIMEOUT_MS=300000
A4B_DOCUMENT_MAX_SUPPLEMENTS=16
# Each neural engine can use its own environment; model downloads are offline.
# EASYFLOW_DOCLING_PYTHON=Backend/.venv-docling/bin/python
# A4B_MINERU_PYTHON=/absolute/path/to/mineru-environment/bin/python
# MINERU_HOME=/absolute/path/to/data/document-runtime/mineru
# MINERU_MODEL_SMALL_BACKEND=torch
# MINERU_MODEL_VLM_ENGINE=llama-cpp
# A4B_PADDLE_PYTHON=/absolute/path/to/paddle-environment/bin/python
# A4B_PADDLE_MODEL_DIR=/absolute/path/to/data/document-runtime/paddlex/official_models
# A4B_PADDLE_DEVICE=cpu
# A4B_LAYOUT_MODEL_DIR=/absolute/path/to/PP-DocLayout_plus-L
# PADDLE_PDX_CACHE_HOME=/absolute/path/to/data/document-runtime/paddlex
# HF_HOME=/absolute/path/to/data/document-runtime/huggingface
# A4B_RHWP=/absolute/path/to/rhwp
# A4B_LIBREOFFICE=/absolute/path/to/soffice

# ---- Former Frontend/.env.example (npm run dev / npm start) ----
# Unset values use server defaults: PORT=3030, A4B_FOCUSED_DEMO=1, A4B_REQUIRE_LOCAL_MODEL=1, data dir 'data'.
# HOST=127.0.0.1
# PORT=3030
# A4B_FOCUSED_DEMO=1

# Paths are relative to the repository root, or may be absolute.
# EASYFLOW_DATA_DIR=data
# A4B_AGENT_PYTHON=/absolute/path/to/Backend/.venv-agent/bin/python
# EASYFLOW_DOCLING_PYTHON=/absolute/path/to/Backend/.venv-docling/bin/python
# EASYFLOW_PUBLIC_URL=https://your-service.example

# Optional limits in milliseconds.
# A4B_WORKER_TIMEOUT_MS=900000
# EASYFLOW_WEBHOOK_RESPONSE_TIMEOUT_MS=60000

# Optional local main model. Leave unset for the original OpenAI path.
# A4B_MAIN_PROVIDER=ollama
# A4B_MAIN_BASE_URL=http://127.0.0.1:11434/v1
# A4B_MAIN_MODEL=qwen3:8b-q4_K_M
# A4B_MAIN_API_KEY=  # only if the selected server requires it

# Independent classifier/verifier: off / shadow (record only) / enforce (gate).
# A4B_VERIFIER_MODE=off
# A4B_OLLAMA_BASE_URL=http://127.0.0.1:11434
# A4B_QWEN_MODEL=qwen3.5:4b
# Optional existing SVM tool hints; never removes tools from the registry.
# A4B_TOOL_ADVICE_MODE=hint
# Requests that mention an uploaded file while none is attached get an upload prompt without a model call.
# A4B_ATTACHMENT_PRECHECK=on

# Main product uses a server-managed Qwen model; no user API key UI.
# A4B_REQUIRE_LOCAL_MODEL=1
# SVM56 hints (opt-in; default off keeps legacy behaviour). Model/catalog come from the team ML package
# (08_서비스연동패키지) and must match the hashes pinned in Backend/ml/svm56/svm56_service_hook.py.
# Relative paths resolve from the directory the server was started in (repository root for npm run dev/start);
# use absolute paths when starting elsewhere.
# A4B_TOOL_ADVICE_BACKEND=svm56
# A4B_SVM_MODEL_PATH=runtime/models/svm56/recommender_char_svm_5431.joblib
# A4B_SVM_CATALOG_PATH=runtime/models/svm56/catalog_56.json
