# Copy to .env in the repository root, replace placeholders, then restart.
HOST=127.0.0.1
PORT=3041
EASYFLOW_DATA_DIR=data-local-integration

# RunPod Pod running an OpenAI-compatible vLLM server, not a Serverless endpoint.
# Use the exact served model name returned by GET /v1/models.
A4B_MAIN_PROVIDER=vllm
A4B_MAIN_BASE_URL=https://YOUR_MAIN_POD-8000.proxy.runpod.net/v1
A4B_MAIN_MODEL=Qwen/Qwen3-8B
A4B_MAIN_API_KEY=YOUR_VLLM_API_KEY

# Independent verifier. It can use a different Pod, or the same endpoint if served there.
A4B_VERIFIER_MODE=shadow
A4B_VERIFIER_PROVIDER=vllm
A4B_VERIFIER_BASE_URL=https://YOUR_VERIFIER_POD-8000.proxy.runpod.net/v1
A4B_VERIFIER_MODEL=Qwen/Qwen3.5-4B
A4B_VERIFIER_API_KEY=YOUR_VERIFIER_VLLM_API_KEY
A4B_VERIFIER_TIMEOUT_S=180

# Keep disabled unless explicitly comparing existing SVM hints.
A4B_TOOL_ADVICE_MODE=off

# Per model call and whole design-worker time budgets (seconds / milliseconds)
A4B_MAIN_TIMEOUT_S=180
A4B_DESIGN_TIMEOUT_MS=600000

# Parser handoff: prepare models explicitly and set absolute cache paths.
A4B_PDF_PARSER_MODE=standard
A4B_PDF_DEVICE=auto
PDF_LIGHTON_ENABLED=0
A4B_PDF_TIMEOUT_MS=300000
# A4B_PDF_ARTIFACTS_DIR=/absolute/path/to/data/pdf-models/docling
# A4B_PDF_OCR_MODEL_DIR=/absolute/path/to/data/pdf-models/docling/EasyOcr
