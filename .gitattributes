# Same line endings on macOS and Windows. Without this, Windows checkouts with core.autocrlf
# turn shell scripts into CRLF (bash: $'\r': command not found) and byte-compared fixtures differ.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.pdf binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary

# Preserve supplied package bytes and their checksum manifests.
Backend/tests/fixtures/parser_handoff/** -text
Backend/tests/fixtures/qwen_verifier/** -text
Backend/ml/legacy/** -text
runtime/ml-bundle/model/recommender_char_svm_5431.joblib -text
runtime/ml-bundle/catalog/catalog_56.json -text whitespace=cr-at-eol

# Evaluation records carry byte-level SHA256 provenance; keep their original bytes.
docs/qwen-* -text
docs/clarification-* -text
# Preserve the one CRLF source file covered by the frozen evaluation source hash.
Backend/agent_builder/design/nodes/direct_conversation.py -text whitespace=cr-at-eol
# Keep byte-hashed local evaluation evidence stable across checkouts.
docs/local-public9b-verification/**/*.json -text whitespace=cr-at-eol
