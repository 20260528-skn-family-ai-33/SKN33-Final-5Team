{
  "version": "tools-v0.1",
  "tools": {
    "read_records": {
      "description": "등록된 시험 데이터 소스의 레코드를 읽는다",
      "inputs": {
        "source_id": "string"
      },
      "outputs": {
        "rows": "records"
      },
      "side_effect": false
    },
    "filter_records": {
      "description": "열과 상수 또는 다른 열을 비교해 행을 필터한다",
      "inputs": {
        "rows": "records",
        "condition": "condition"
      },
      "outputs": {
        "rows": "records"
      },
      "side_effect": false
    },
    "aggregate_records": {
      "description": "등록된 숫자 열의 합계 또는 레코드 수를 계산한다",
      "inputs": {
        "rows": "records",
        "operation": "string",
        "field": "string"
      },
      "outputs": {
        "result": "object"
      },
      "side_effect": false
    },
    "save_report": {
      "description": "결과를 허용된 보고서 목적지에 저장한다",
      "inputs": {
        "content": "object_or_records",
        "destination_id": "string"
      },
      "outputs": {
        "artifact_id": "string"
      },
      "side_effect": true
    },
    "notify": {
      "description": "결과를 연결된 수신 대상에 알린다",
      "inputs": {
        "content": "object_or_records",
        "recipient_id": "string"
      },
      "outputs": {
        "delivery_id": "string"
      },
      "side_effect": true
    },
    "search_document": {
      "description": "등록된 문서 범위에서 질문의 근거를 검색한다",
      "inputs": {
        "document_id": "string",
        "query": "string"
      },
      "outputs": {
        "evidence": "records"
      },
      "side_effect": false
    }
  }
}