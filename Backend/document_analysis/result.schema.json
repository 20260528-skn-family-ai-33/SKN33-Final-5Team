{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a4b:document-analysis:v1",
  "title": "Document analysis and routing result v1",
  "type": "object",
  "required": ["contract_version", "document_id", "source_sha256", "source_format", "primary_processor", "units", "blocks", "routes", "routing_decisions", "coverage", "status", "review_required", "review_reasons", "warnings"],
  "properties": {
    "contract_version": {"const": "a4b.document_analysis.v1"},
    "document_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_format": {"type": "string"},
    "primary_processor": {"enum": ["native", "mineru", "docling", "layout"]},
    "status": {"enum": ["succeeded", "partial"]},
    "review_required": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "review_reasons": {"type": "array", "items": {"type": "string"}},
    "units": {"type": "array", "maxItems": 500, "items": {"type": "object", "required": ["id", "native_location"], "properties": {"id": {"type": "string"}, "native_location": {"type": "object"}}}},
    "blocks": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/block"}},
    "routes": {"type": "array", "items": {"type": "object", "required": ["id", "phase", "processor", "status", "elapsed_seconds"], "properties": {"id": {"type": "string"}, "phase": {"type": "string"}, "processor": {"type": "string"}, "status": {"enum": ["succeeded", "partial", "failed"]}, "elapsed_seconds": {"type": "number", "minimum": 0}}}},
    "routing_decisions": {"type": "array", "items": {"type": "object", "required": ["phase", "rule", "processor"]}},
    "coverage": {"type": "object"}
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["id", "parent_object_id", "unit_id", "content_types", "native_location", "text", "data", "engine", "bbox", "status", "warnings"],
      "properties": {
        "id": {"type": "string"},
        "parent_object_id": {"type": ["string", "null"]},
        "unit_id": {"type": ["string", "null"]},
        "content_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "native_location": {"type": "object"},
        "text": {"type": "string", "maxLength": 1000000},
        "data": {"type": "object"},
        "engine": {"type": "string"},
        "selected": {"type": "boolean"},
        "status": {"enum": ["succeeded", "review_required"]},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "bbox": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["values", "coordinate_system"], "properties": {"values": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "coordinate_system": {"type": "string"}}}]}
      }
    }
  }
}
