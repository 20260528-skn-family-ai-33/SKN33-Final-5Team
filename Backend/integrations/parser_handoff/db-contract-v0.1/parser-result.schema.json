{
  "type": "object",
  "description": "A4B 파서 전달 규격 초안. PDF/PNG/JPEG 우선. WORD/EXCEL 위치 확장은 후속 버전에서 합의한다.",
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "파서 전달 규격 버전. 업무 추출 규격 버전과 별개.",
      "const": "a4b.parser_result.v0.1-draft"
    },
    "source": {
      "$ref": "#/$defs/source",
      "description": "원본 식별"
    },
    "processing": {
      "$ref": "#/$defs/processing",
      "description": "처리 결과"
    },
    "coordinate_system": {
      "type": "object",
      "description": "좌표 약속",
      "properties": {
        "origin": {
          "type": "string",
          "description": "좌표 원점",
          "const": "top_left"
        },
        "unit": {
          "type": "string",
          "description": "좌표 단위",
          "const": "normalized_0_1"
        },
        "bbox_meaning": {
          "type": "string",
          "description": "보이는 글자 영역",
          "const": "visible_text_bounds"
        }
      },
      "required": [
        "origin",
        "unit",
        "bbox_meaning"
      ],
      "additionalProperties": false
    },
    "text_indexing": {
      "type": "object",
      "description": "문자 위치 약속",
      "properties": {
        "unit": {
          "type": "string",
          "description": "문자 인덱스 단위",
          "const": "unicode_code_point"
        },
        "start_index": {
          "const": 0,
          "description": "0부터 시작"
        },
        "end": {
          "type": "string",
          "description": "끝 인덱스 포함 여부",
          "const": "exclusive"
        },
        "normalization": {
          "type": "string",
          "description": "임의 NFC/NFKC·trim을 하지 않음",
          "const": "none"
        }
      },
      "required": [
        "unit",
        "start_index",
        "end",
        "normalization"
      ],
      "additionalProperties": false
    },
    "canonical_text": {
      "type": "string",
      "description": "완료한 처리 범위의 고정 기준 본문. 선택 페이지 예시는 원본 전체 본문이 아니다."
    },
    "canonical_text_sha256": {
      "type": "string",
      "description": "canonical_text UTF8 바이트 해시. BOM 없음.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page",
        "description": "페이지"
      },
      "description": "처리한 페이지 메타데이터"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block",
        "description": "블록"
      },
      "description": "기준 본문 순서의 블록"
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table",
        "description": "표"
      },
      "description": "보완 후 표 구조"
    },
    "source_locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location",
        "description": "위치"
      },
      "description": "본문과 표를 원본 위치에 연결"
    }
  },
  "required": [
    "contract_version",
    "source",
    "processing",
    "coordinate_system",
    "text_indexing",
    "canonical_text",
    "canonical_text_sha256",
    "pages",
    "blocks",
    "tables",
    "source_locations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "bbox": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        }
      ],
      "description": "[x0,y0,x1,y1]，좌측 상단·0~1. null은 좌표 미확보. 실제 글자 영역이며 병합 셀의 논리 격자 범위와 다르다. x0<x1,y0<y1은 별도 검사."
    },
    "source": {
      "type": "object",
      "description": "원본 식별 정보. DB의 document_id나 version UUID를 파서가 생성하지 않는다.",
      "properties": {
        "file_name": {
          "type": "string",
          "description": "원본 파일명. 로컬 절대 경로나 S3 업로드 권한을 담지 않는다."
        },
        "mime_type": {
          "type": "string",
          "description": "v0.1 대상 형식. 이미지 입력은 제안 규격이며 서비스 지원을 뜻하지 않는다.",
          "enum": [
            "application/pdf",
            "image/png",
            "image/jpeg"
          ]
        },
        "sha256": {
          "type": "string",
          "description": "원본 바이트 SHA256. 백엔드가 실제 업로드 파일과 재검증한다.",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "원본 바이트 크기"
        },
        "page_count_total": {
          "type": "integer",
          "minimum": 1,
          "description": "원본 전체 페이지 수. 이미지 한 장은1."
        }
      },
      "required": [
        "file_name",
        "mime_type",
        "sha256",
        "size_bytes",
        "page_count_total"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "description": "이 예시를 재구성한 검증 산출물",
      "properties": {
        "name": {
          "type": "string",
          "description": "검증 출처 파일명"
        },
        "sha256": {
          "type": "string",
          "description": "출처 파일 바이트 해시",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "name",
        "sha256"
      ],
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "description": "처리 경고. 경고 존재와 DB ready 여부는 별도 정책이다.",
      "properties": {
        "code": {
          "type": "string",
          "description": "기계가 분류할 경고 코드"
        },
        "severity": {
          "type": "string",
          "description": "경고 수준",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "description": "검토자가 읽을 설명. 원문 밖의 민감한 실행 정보는 넣지 않는다."
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "description": "실패 정보. 실패 원문이나 오류 prefix를 정상 결과로 쓰지 않는다.",
      "properties": {
        "code": {
          "type": "string",
          "description": "실패 분류 코드"
        },
        "message": {
          "type": "string",
          "description": "실패 이유"
        },
        "retryable": {
          "type": "boolean",
          "description": "새 작업·새 처리 버전으로 재시도할 수 있는지"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "parser": {
      "type": "object",
      "description": "실행 소프트웨어 식별. 예시의 패키지 버전 미기록은 경고로 보존한다.",
      "properties": {
        "engine": {
          "type": "string",
          "description": "파서 엔진",
          "const": "docling"
        },
        "package_version": {
          "anyOf": [
            {
              "type": "string",
              "description": "실행한 Docling 패키지 버전"
            },
            {
              "type": "null"
            }
          ],
          "description": "미기록 시 null. DoclingDocument.version과 혼동하지 않는다."
        },
        "postprocessor_revision": {
          "type": "string",
          "description": "보완 후처리 코드 스냅샷 해시",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "engine",
        "package_version",
        "postprocessor_revision"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "description": "실제 파싱 값과 새로 제안한 포맷을 구분한다.",
      "properties": {
        "derivation": {
          "type": "string",
          "description": "native_runtime=직접 반환, adapter_replay_from_verified_artifacts=검증 결과 변환, illustrative_example=설명용 합성 예시",
          "enum": [
            "native_runtime",
            "adapter_replay_from_verified_artifacts",
            "illustrative_example"
          ]
        },
        "service_integration": {
          "type": "boolean",
          "description": "현재 서비스 반환 API에 연결됐는지. 이 초안은 false."
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact",
            "description": "검증 출처"
          },
          "description": "재구성 근거 목록"
        }
      },
      "required": [
        "derivation",
        "service_integration",
        "source_artifacts"
      ],
      "additionalProperties": false
    },
    "processing": {
      "type": "object",
      "description": "처리 상태와 재현 정보",
      "properties": {
        "outcome": {
          "type": "string",
          "description": "요청한 처리 범위에 대한 결과. DB document_versions.status 값과 별개.",
          "enum": [
            "succeeded",
            "partial",
            "failed"
          ]
        },
        "scope": {
          "type": "string",
          "description": "전체 문서 또는 선택 페이지",
          "enum": [
            "full_document",
            "selected_pages"
          ]
        },
        "requested_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "description": "요청한 원본 페이지 번호"
          },
          "description": "처리 요청 범위",
          "uniqueItems": true,
          "minItems": 1
        },
        "completed_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "description": "완료한 원본 페이지 번호"
          },
          "description": "완료 페이지",
          "uniqueItems": true
        },
        "failed_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "description": "실패한 원본 페이지 번호"
          },
          "description": "실패 페이지",
          "uniqueItems": true
        },
        "whole_document_complete": {
          "type": "boolean",
          "description": "원본 전체가 준비됐는지. 67페이지 발췌 예시는 false."
        },
        "parser": {
          "$ref": "#/$defs/parser",
          "description": "파서 식별"
        },
        "config_json": {
          "type": "object",
          "description": "작업 시작 전 고정할 OCR·표·정규화·청킹 설정. embedding이 불필요하면 키 자체를 생략. null은 DB v2 프로필 검증을 통과하지 못한다."
        },
        "provenance": {
          "$ref": "#/$defs/provenance",
          "description": "값의 출처"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning",
            "description": "경고"
          },
          "description": "누락·보류·변환 범위를 숨기지 않는다."
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/error",
              "description": "오류"
            },
            {
              "type": "null"
            }
          ],
          "description": "실패 시 오류 객체, 정상 시 null"
        }
      },
      "required": [
        "outcome",
        "scope",
        "requested_pages",
        "completed_pages",
        "failed_pages",
        "whole_document_complete",
        "parser",
        "config_json",
        "provenance",
        "warnings",
        "error"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "description": "페이지 크기. bbox 정규화의 기준이다.",
      "properties": {
        "page_no": {
          "type": "integer",
          "minimum": 1,
          "description": "원본 기준1부터. 선택 처리해도67을1로 바꾸지 않는다."
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "원본 페이지 가로 크기"
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "원본 페이지 세로 크기"
        },
        "unit": {
          "type": "string",
          "description": "크기 단위",
          "enum": [
            "pdf_point",
            "pixel"
          ]
        }
      },
      "required": [
        "page_no",
        "width",
        "height",
        "unit"
      ],
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "description": "문서 순서를 가진 블록. canonical_text는 블록 사이 두 LF를 포함해 고정한다.",
      "properties": {
        "block_key": {
          "type": "string",
          "description": "문서 처리 버전 안에서 유일한 블록 식별자"
        },
        "type": {
          "type": "string",
          "description": "블록 유형",
          "enum": [
            "text",
            "table"
          ]
        },
        "role": {
          "type": "string",
          "description": "파서에서 관측한 역할. 예: text,footnote,table."
        },
        "page_no": {
          "type": "integer",
          "minimum": 1,
          "description": "원본 페이지 번호"
        },
        "parser_source_ref": {
          "type": "string",
          "description": "원본 Docling 객체 참조. 분리 후 여러 블록이 같은 참조를 가질 수 있어 고유키로 쓰지 않는다."
        },
        "text": {
          "type": "string",
          "description": "기준 본문에 실제로 들어간 블록 텍스트",
          "minLength": 1
        },
        "char_start": {
          "type": "integer",
          "minimum": 0,
          "description": "전체 canonical_text 내 시작 code point"
        },
        "char_end": {
          "type": "integer",
          "minimum": 1,
          "description": "전체 canonical_text 내 끝 code point. 끝 미포함"
        },
        "bbox": {
          "$ref": "#/$defs/bbox",
          "description": "블록 글자 영역의 합집합"
        },
        "table_key": {
          "anyOf": [
            {
              "type": "string",
              "description": "구조화 표 참조"
            },
            {
              "type": "null"
            }
          ],
          "description": "표 블록만 table_key, 일반 텍스트는 null"
        },
        "location_no": {
          "type": "integer",
          "minimum": 1,
          "description": "source_locations의 위치 번호"
        }
      },
      "required": [
        "block_key",
        "type",
        "role",
        "page_no",
        "parser_source_ref",
        "text",
        "char_start",
        "char_end",
        "bbox",
        "table_key",
        "location_no"
      ],
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "description": "표의 기준 셀. 병합 셀은 시작 셀 한 번만 저장한다.",
      "properties": {
        "cell_key": {
          "type": "string",
          "description": "처리 버전 안에서 유일한 셀 식별자"
        },
        "row": {
          "type": "integer",
          "minimum": 1,
          "description": "1부터 시작하는 행"
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "description": "1부터 시작하는 열"
        },
        "row_span": {
          "type": "integer",
          "minimum": 1,
          "description": "병합 행 수"
        },
        "col_span": {
          "type": "integer",
          "minimum": 1,
          "description": "병합 열 수"
        },
        "text": {
          "type": "string",
          "description": "읽힌 셀 원문 문자열. 금액을 JSON 숫자로 강제 변환하지 않는다."
        },
        "is_column_header": {
          "type": "boolean",
          "description": "현재 파서·후처리의 열 헤더 표시. 실제 원문 일치와 별도 검증."
        },
        "is_row_header": {
          "type": "boolean",
          "description": "현재 파서의 행 헤더 표시"
        },
        "bbox": {
          "$ref": "#/$defs/bbox",
          "description": "셀 글자 좌표. 병합 범위는 row_span/col_span으로 표현."
        },
        "char_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "description": "셀 원문의 기준 본문 시작"
            },
            {
              "type": "null"
            }
          ],
          "description": "빈 셀은 null"
        },
        "char_end": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "description": "셀 원문의 기준 본문 끝"
            },
            {
              "type": "null"
            }
          ],
          "description": "빈 셀은 null"
        },
        "location_no": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "description": "원문 위치 번호"
            },
            {
              "type": "null"
            }
          ],
          "description": "빈 셀은 null. 실제 원문이 없으면 근거로 쓰지 않는다."
        },
        "header_path": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "description": "상위에서 하위 순서의 헤더 문자열"
              },
              "description": "편의용 파생 경로"
            },
            {
              "type": "null"
            }
          ],
          "description": "null=파생 안 함, []=계산했으나 상위 헤더 없음. 예: [2023년,1차 협력회사]. 원문·병합 구조가 우선이며 이 예시는 두 준수율 표에만 생성한다."
        }
      },
      "required": [
        "cell_key",
        "row",
        "column",
        "row_span",
        "col_span",
        "text",
        "is_column_header",
        "is_row_header",
        "bbox",
        "char_start",
        "char_end",
        "location_no",
        "header_path"
      ],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "description": "표 구조. 순서·병합·셀 원문을 보존한다.",
      "properties": {
        "table_key": {
          "type": "string",
          "description": "표 식별자"
        },
        "block_key": {
          "type": "string",
          "description": "소속 블록 식별자"
        },
        "page_no": {
          "type": "integer",
          "minimum": 1,
          "description": "원본 페이지 번호"
        },
        "row_count": {
          "type": "integer",
          "minimum": 1,
          "description": "논리 행 수"
        },
        "column_count": {
          "type": "integer",
          "minimum": 1,
          "description": "논리 열 수"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell",
            "description": "셀"
          },
          "description": "보완 후 구조화 셀 목록"
        },
        "html": {
          "type": "string",
          "description": "기존 검증 실행에서 생성한 보완 후 HTML. 보기용이며 canonical_text 문자 위치의 기준이 아니다."
        }
      },
      "required": [
        "table_key",
        "block_key",
        "page_no",
        "row_count",
        "column_count",
        "cells",
        "html"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "description": "RDS source_locations로 변환할 제안 레코드. UUID/FK는 백엔드가 채운다. PDF 표의 row/column을 sheet 필드에 넣지 않는다.",
      "properties": {
        "location_no": {
          "type": "integer",
          "minimum": 1,
          "description": "이 처리 결과 안에서 유일한 위치 순번. DB UNIQUE(document_version_id,location_no)에 대응."
        },
        "location_type": {
          "type": "string",
          "description": "v0.1은 PDF·이미지의 page 위치를 우선 정의.",
          "const": "page"
        },
        "page_no": {
          "type": "integer",
          "minimum": 1,
          "description": "원본 페이지 번호. 이미지 한 장은1."
        },
        "block_key": {
          "type": "string",
          "description": "해당 블록 또는 셀의 key. S3 JSON에서 원문을 찾는 주소."
        },
        "char_start": {
          "type": "integer",
          "minimum": 0,
          "description": "전체 기준 본문의 시작 code point"
        },
        "char_end": {
          "type": "integer",
          "minimum": 1,
          "description": "끝 미포함 code point"
        },
        "bbox": {
          "$ref": "#/$defs/bbox",
          "description": "원문 글자 좌표. 미확보 시 null, 임의로 만들지 않는다."
        },
        "label": {
          "type": "string",
          "description": "사람이 확인할 표·행·열 설명"
        }
      },
      "required": [
        "location_no",
        "location_type",
        "page_no",
        "block_key",
        "char_start",
        "char_end",
        "bbox",
        "label"
      ],
      "additionalProperties": false
    }
  }
