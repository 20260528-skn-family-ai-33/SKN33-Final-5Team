{
  "name": "a4b-agent-studio",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup-python.mjs",
    "setup:docling": "node scripts/setup-python.mjs --docling",
    "demo": "node scripts/launch-demo.mjs",
    "dev": "npm run build && node --env-file-if-exists=.env --import tsx server/launch.ts",
    "build": "vite build && esbuild server/launch.ts --bundle --platform=node --format=esm --packages=external --outfile=build-server/index.mjs",
    "start": "node --env-file-if-exists=.env build-server/index.mjs",
    "check": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test --test-concurrency=4 --test-timeout=900000 server/*.test.ts",
    "pretest": "npm run build",
    "test:python": "node --env-file-if-exists=.env --import tsx scripts/test-python.ts",
    "verify:review:live": "node --import tsx scripts/live-check-reply-review.ts",
    "tool-lab": "node --import tsx server/tool-lab/cli.ts",
    "tool-lab:demo": "node --import tsx server/tool-lab/cli.ts --demo",
    "tool-lab:gap": "node --import tsx server/tool-lab/gap-cli.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@shadcn/react": "^0.3.0",
    "busboy": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "4.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "pdf-parse": "2.4.5",
    "quickjs-emscripten": "^0.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "xml2js": "0.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/busboy": "1.5.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/xml2js": "0.4.14",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "jsdom": "30.1.3",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  },
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
