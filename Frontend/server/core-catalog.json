 "schemaVersion":1,"verifiedDate":"2026-10-07","catalog":[
  {"id":"switch","name":"여러 조건으로 나누기","englishName":"Switch","category":"흐름","n8nType":"n8n-nodes-base.switch","typeVersion":3.2,"description":"조건별로 다른 경로에 데이터를 보내고, 남은 데이터는 기본 경로로 보내요.","inputs":1,"outputs":["긴급","일반","기본 경로"],"parameters":{"mode":"rules","rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.priority }}","rightValue":"urgent","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"긴급"},{"conditions":{"options":{"caseSensitive":true,"typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.priority }}","rightValue":"normal","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"일반"}]},"options":{"fallbackOutput":"extra","allMatchingOutputs":false,"ignoreCase":false}},"locallyExecutable":true,"requires":[],"setupGuidance":["priority가 urgent이면 긴급, normal이면 일반, 나머지는 기본 경로로 보내요.","경로는 조건 순서대로 0번부터 연결해요. 조건을 추가하면 경로도 늘어나요.","번호 방식에서는 numberOutputs와 output에 0부터 시작하는 경로 번호를 설정해요."],"fields":[{"key":"mode","label":"경로 결정 방식","type":"select","options":[{"value":"rules","label":"조건으로 선택"},{"value":"expression","label":"데이터의 경로 번호로 선택"}]},{"key":"rules","label":"경로별 조건 JSON","type":"json","showWhen":{"mode":["rules"]},"help":"values 배열에 경로별 조건과 outputKey 이름을 입력해요."},{"key":"numberOutputs","label":"경로 수","type":"number","showWhen":{"mode":["expression"]}},{"key":"output","label":"경로 번호 또는 데이터 연결","type":"text","placeholder":"={{ $json.route }}","showWhen":{"mode":["expression"]}},{"key":"options","label":"기본 경로·모든 조건 처리 JSON","type":"json","showWhen":{"mode":["rules"]},"help":"fallbackOutput: extra는 기본 경로, none은 버리기예요. allMatchingOutputs: true는 맞는 모든 경로로 보내요."}],"docsUrl":"https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.switch/","sourceUrl":"https://raw.githubusercontent.com/n8n-io/n8n/master/packages/nodes-base/nodes/Switch/V3/SwitchV3.node.ts"},
  {"id":"filter","name":"필요한 데이터만 남기기","englishName":"Filter","category":"데이터","n8nType":"n8n-nodes-base.filter","typeVersion":2.2,"description":"조건에 맞는 항목만 다음 단계로 보내요.","inputs":1,"outputs":["조건에 맞는 데이터"],"parameters":{"conditions":{"options":{"typeValidation":"strict","caseSensitive":true},"conditions":[{"leftValue":"={{ $json.score }}","rightValue":80,"operator":{"type":"number","operation":"gte"}}],"combinator":"and"},"options":{}},"locallyExecutable":true,"requires":[],"setupGuidance":["예시는 score가 80 이상인 항목만 남겨요.","and는 모든 조건, or는 하나 이상의 조건에 맞는 데이터를 남겨요.","정규식 비교는 아직 지원하지 않아요. 복잡한 처리는 맞춤 계산 단계를 사용해주세요."],"fields":[{"key":"conditions","label":"남길 데이터의 조건 JSON","type":"json"},{"key":"options","label":"대소문자 등 옵션 JSON","type":"json","help":"ignoreCase: true는 글자 대소문자를 구분하지 않아요."}],"docsUrl":"https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.filter/"},
  {"id":"limit","name":"개수만큼 남기기","englishName":"Limit","category":"데이터","n8nType":"n8n-nodes-base.limit","typeVersion":1,"description":"처음 또는 마지막에서 원하는 개수의 항목을 남겨요.","inputs":1,"outputs":["남긴 데이터"],"parameters":{"maxItems":1,"keep":"firstItems"},"locallyExecutable":true,"requires":[],"setupGuidance":["처음 1개를 남기는 설정으로 시작해요.","최대 5,000개까지 남길 수 있어요."],"fields":[{"key":"maxItems","label":"남길 항목 수","type":"number"},{"key":"keep","label":"어디에서 남길까요?","type":"select","options":[{"value":"firstItems","label":"처음 항목부터"},{"value":"lastItems","label":"마지막 항목부터"}]}],"docsUrl":"https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.limit/"},
  {"id":"sort","name":"순서 바꾸기","englishName":"Sort","category":"데이터","n8nType":"n8n-nodes-base.sort","typeVersion":1,"description":"숫자나 글자 기준으로 정렬하거나 무작위 순서로 바꿔요.","inputs":1,"outputs":["정렬한 데이터"],"parameters":{"type":"simple","sortFieldsUi":{"sortField":[{"fieldName":"score","order":"descending"}]},"options":{}},"locallyExecutable":true,"requires":[],"setupGuidance":["예시는 score가 높은 항목부터 보여줘요.","sortField 배열에 항목을 추가하면 여러 기준으로 정렬해요. 글자는 대소문자를 구분하지 않아요.","코드 정렬의 a.json과 b.json을 비교해 -1, 0, 1을 반환하세요. 코드는 제한된 실행 환경에서 처리해요."],"fields":[{"key":"type","label":"정렬 방식","type":"select","options":[{"value":"simple","label":"항목 기준으로 정렬"},{"value":"random","label":"무작위 순서"},{"value":"code","label":"맞춤 비교 코드"}]},{"key":"sortFieldsUi","label":"정렬 기준 JSON","type":"json","showWhen":{"type":["simple"]},"help":"sortField 배열의 fieldName은 항목 이름, order는 ascending 또는 descending이에요."},{"key":"code","label":"비교 코드","type":"textarea","showWhen":{"type":["code"]},"placeholder":"return a.json.score - b.json.score;"},{"key":"options","label":"옵션 JSON","type":"json","showWhen":{"type":["simple"]}}],"docsUrl":"https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.sort/"},
  {"id":"splitOut","name":"목록을 하나씩 펼치기","englishName":"Split Out","category":"데이터","n8nType":"n8n-nodes-base.splitOut","typeVersion":1.1,"description":"한 항목 안의 목록을 여러 데이터 항목으로 펼쳐요.","inputs":1,"outputs":["펼친 데이터"],"parameters":{"fieldToSplitOut":"items","include":"noOtherFields","options":{}},"locallyExecutable":true,"requires":[],"setupGuidance":["목록이 들어 있는 항목 이름을 입력하세요. 예시는 items 목록을 펼쳐요.","nested.items처럼 안쪽 목록을 선택하거나 쉼표로 여러 목록을 지정할 수 있어요. 여러 목록은 같은 위치의 값을 함께 묶어요.","파일 목록은 아직 지원하지 않아요. 결과는 최대 5,000개예요."],"fields":[{"key":"fieldToSplitOut","label":"펼칠 목록의 항목 이름","type":"text","placeholder":"items 또는 customer.orders"},{"key":"include","label":"다른 항목도 남길까요?","type":"select","options":[{"value":"noOtherFields","label":"목록 내용만 남기기"},{"value":"allOtherFields","label":"다른 항목 모두 남기기"},{"value":"selectedOtherFields","label":"선택한 항목만 남기기"}]},{"key":"fieldsToInclude","label":"함께 남길 항목","type":"text","placeholder":"orderId,customer","showWhen":{"include":["selectedOtherFields"]}},{"key":"options","label":"출력 이름 등 옵션 JSON","type":"json","help":"destinationFieldName으로 펼친 값을 담을 항목 이름을 정해요."}],"docsUrl":"https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.splitout/"},
  {"id":"removeDuplicates","name":"겹치는 데이터 빼기","englishName":"Remove Duplicates","category":"데이터","n8nType":"n8n-nodes-base.removeDuplicates","typeVersion":2,"description":"이번 입력 안에서 중복된 항목을 빼고 첫 번째 항목을 남겨요.","inputs":1,"outputs":["중복을 뺀 데이터"],"parameters":{"operation":"removeDuplicateInputItems","compare":"allFields","options":{}},"locallyExecutable":true,"requires":[],"setupGuidance":["모든 항목이 같은 데이터 또는 선택한 항목이 같은 데이터를 찾을 수 있어요.","이전 실행과의 중복 비교와 기록 지우기는 아직 지원하지 않아요."],"fields":[{"key":"compare","label":"무엇이 같으면 중복인가요?","type":"select","options":[{"value":"allFields","label":"모든 항목이 같을 때"},{"value":"selectedFields","label":"선택한 항목만 같을 때"},{"value":"allFieldsExcept","label":"일부 항목을 제외하고 같을 때"}]},{"key":"fieldsToCompare","label":"비교할 항목","type":"text","placeholder":"email 또는 person.email","showWhen":{"compare":["selectedFields"]}},{"key":"fieldsToExclude","label":"비교에서 뺄 항목","type":"text","placeholder":"updatedAt,requestId","showWhen":{"compare":["allFieldsExcept"]}},{"key":"options","label":"옵션 JSON","type":"json","help":"removeOtherFields: true는 비교한 항목만 결과에 남겨요."}],"docsUrl":"https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.removeduplicates/"},
  {"id":"aggregate","name":"여러 데이터를 한 목록으로","englishName":"Aggregate","category":"데이터","n8nType":"n8n-nodes-base.aggregate","typeVersion":1,"description":"여러 항목 전체 또는 특정 값들을 하나의 목록으로 묶어요.","inputs":1,"outputs":["묶은 데이터"],"parameters":{"aggregate":"aggregateAllItemData","destinationFieldName":"data","include":"allFields","options":{}},"locallyExecutable":true,"requires":[],"setupGuidance":["예시는 모든 항목을 data라는 목록에 담아요.","특정 항목 집계에서는 fieldsToAggregate.fieldToAggregate 배열에 항목 이름을 지정해요.","mergeLists: true는 목록을 한 단계 펼치고 keepMissing: true는 없는 값도 null로 남겨요."],"fields":[{"key":"aggregate","label":"어떤 데이터를 묶을까요?","type":"select","options":[{"value":"aggregateAllItemData","label":"항목 전체를 목록으로"},{"value":"aggregateIndividualFields","label":"특정 항목 값만 목록으로"}]},{"key":"destinationFieldName","label":"목록을 담을 항목 이름","type":"text","showWhen":{"aggregate":["aggregateAllItemData"]}},{"key":"include","label":"포함 범위","type":"select","options":[{"value":"allFields","label":"모든 항목"},{"value":"specifiedFields","label":"선택한 항목"},{"value":"allFieldsExcept","label":"선택한 항목 제외"}],"showWhen":{"aggregate":["aggregateAllItemData"]}},{"key":"fieldsToInclude","label":"포함할 항목","type":"text","showWhen":{"include":["specifiedFields"]}},{"key":"fieldsToExclude","label":"제외할 항목","type":"text","showWhen":{"include":["allFieldsExcept"]}},{"key":"fieldsToAggregate","label":"집계할 항목 설정 JSON","type":"json","showWhen":{"aggregate":["aggregateIndividualFields"]},"placeholder":"{\"fieldToAggregate\":[{\"fieldToAggregate\":\"score\",\"renameField\":false}]}"},{"key":"options","label":"목록 펼치기 등 옵션 JSON","type":"json"}],"docsUrl":"https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.aggregate/"},
  {"id":"stopAndError","name":"오류를 알리고 중단하기","englishName":"Stop And Error","category":"흐름","n8nType":"n8n-nodes-base.stopAndError","typeVersion":1,"description":"입력 검증에 실패했을 때 이유를 실행 기록에 남기고 중단해요.","inputs":1,"outputs":[],"parameters":{"errorType":"errorMessage","errorMessage":"자동화를 중단했어요."},"locallyExecutable":true,"requires":[],"setupGuidance":["중단 이유를 글로 입력하거나 앞 단계의 reason 항목을 연결하세요.","오류 처리 설정으로 별도 오류 경로에 전달할 수도 있어요."],"fields":[{"key":"errorType","label":"오류 내용 형식","type":"select","options":[{"value":"errorMessage","label":"글로 작성"},{"value":"errorObject","label":"JSON 객체로 작성"}]},{"key":"errorMessage","label":"중단 이유","type":"textarea","showWhen":{"errorType":["errorMessage"]}},{"key":"errorObject","label":"오류 객체 JSON","type":"json","showWhen":{"errorType":["errorObject"]},"placeholder":"{\"message\":\"필수 항목이 없어요\"}"}],"docsUrl":"https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.stopanderror/"},
  {"id":"executeWorkflow","name":"다른 자동화 불러오기","englishName":"Execute Sub-workflow","category":"흐름","n8nType":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"description":"저장한 다른 자동화를 호출하고 그 결과를 이어서 사용해요.","inputs":1,"outputs":["하위 자동화 결과"],"parameters":{"source":"database","workflowId":"","mode":"once","options":{"waitForSubWorkflow":true}},"locallyExecutable":true,"requires":["저장된 하위 자동화"],"setupGuidance":["저장한 자동화 ID를 입력하세요. 하위 자동화도 시작 단계를 하나 포함해야 해요.","전체 입력 또는 항목마다 실행할 수 있어요. 완료를 기다리고 실제 결과를 돌려줘요.","하위 자동화의 대기 상태도 저장해 이어 실행해요. 호출 깊이는 최대 8단계예요.","외부 URL과 파일에서 자동화를 읽는 방식, 완료를 기다리지 않는 방식은 아직 지원하지 않아요."],"fields":[{"key":"workflowId","label":"불러올 자동화 ID","type":"text","placeholder":"저장한 자동화의 ID"},{"key":"mode","label":"실행 단위","type":"select","options":[{"value":"once","label":"전체 입력을 한 번에"},{"value":"each","label":"항목마다 한 번씩"}]},{"key":"workflowInputs","label":"입력 값 연결 JSON · 선택","type":"json","help":"value 객체의 값을 앞 단계 데이터와 연결해요. 비워두면 모든 입력을 전달해요."}],"docsUrl":"https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.executeworkflow/"},
  {"id":"executeWorkflowTrigger","name":"다른 자동화가 불러서 시작","englishName":"Execute Sub-workflow Trigger","category":"시작","n8nType":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1,"description":"다른 자동화가 전달한 데이터를 받아 시작해요.","inputs":0,"outputs":["전달받은 데이터"],"parameters":{"inputSource":"passthrough"},"locallyExecutable":true,"requires":[],"setupGuidance":["하위 자동화의 첫 단계로 연결하고 저장하세요.","다른 자동화 불러오기 단계에서 이 자동화 ID를 선택하면 전달받은 데이터로 시작해요."],"docsUrl":"https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.executeworkflowtrigger/"},
  {"id":"errorTrigger","name":"자동화 오류로 시작","englishName":"Error Trigger","category":"시작","n8nType":"n8n-nodes-base.errorTrigger","typeVersion":1,"description":"예약·Webhook 자동화에 오류가 생기면 오류 정보로 후속 처리를 시작해요.","inputs":0,"outputs":["오류 정보"],"parameters":{},"locallyExecutable":true,"requires":["원래 자동화의 오류 자동화 설정"],"setupGuidance":["오류 처리용 자동화의 시작 단계로 저장하고 원래 자동화 설정에서 선택하세요.","execution.error.message에 오류 이유, workflow에 원래 자동화 정보가 있어요.","오류 처리 자동화가 다시 오류를 일으켜도 무한히 호출하지 않아요."],"docsUrl":"https://docs.n8n.io/integrations/builtin/core-nodes/n8n-nodes-base.errortrigger/"}
 ]
