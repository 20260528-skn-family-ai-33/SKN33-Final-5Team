{
  "name": "요청에 결과 돌려주기",
  "description": "주문 요청을 받아 고객명과 주문 번호를 정리하고, 요청을 보낸 앱에 JSON 결과를 돌려주는 예제입니다. 자동 실행을 켠 뒤 요청 주소의 :orderId를 실제 주문 번호로 바꾸고 POST로 {\"customer\":\"예시 고객\"}를 보내세요.",
  "active": false,
  "nodes": [
    {
      "id": "c12f3d72-20b5-4f0d-a510-ceb29df6da53",
      "name": "주문 요청 받기",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [120, 320],
      "parameters": {
        "httpMethod": "POST",
        "path": "orders/:orderId",
        "authentication": "easyflowToken",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "6562aa7e-8c25-4410-9789-3242224c6ac8",
      "name": "주문 정보 정리",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [350, 320],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {"id": "customer", "name": "customer", "type": "string", "value": "={{ $json.body.customer }}"},
            {"id": "orderId", "name": "orderId", "type": "string", "value": "={{ $json.params.orderId }}"},
            {"id": "message", "name": "message", "type": "string", "value": "주문을 접수했어요."}
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "c4b58f3b-a788-4013-8e27-aea01f80a81a",
      "name": "주문 결과 돌려주기",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [580, 320],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "enableResponseOutput": true,
        "options": {
          "responseCode": 201,
          "responseHeaders": {"entries": [{"name": "X-Easyflow-Example", "value": "order-response"}]}
        }
      }
    },
    {
      "id": "18b72b1c-d8c8-4ba5-8519-15a2f12118fa",
      "name": "원래 주문 정보",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [840, 230],
      "parameters": {}
    },
    {
      "id": "66cb9647-45a9-4709-8616-57c424eaf72a",
      "name": "보낸 응답 정보",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [840, 430],
      "parameters": {}
    }
  ],
  "connections": {
    "주문 요청 받기": {"main": [[{"node": "주문 정보 정리", "type": "main", "index": 0}]]},
    "주문 정보 정리": {"main": [[{"node": "주문 결과 돌려주기", "type": "main", "index": 0}]]},
    "주문 결과 돌려주기": {"main": [
      [{"node": "원래 주문 정보", "type": "main", "index": 0}],
      [{"node": "보낸 응답 정보", "type": "main", "index": 0}]
    ]}
  },
  "settings": {"executionOrder": "v1", "timezone": "Asia/Seoul"}
}
