    {
      "id": "read",
      "name": "재고 시트 읽기",
      "type": "easyflow.googleSheets",
      "typeVersion": 1,
      "position": [
        350,
        300
      ],
      "parameters": {
        "operation": "read",
        "spreadsheetId": "1MU0Y8jy7Ot3sXjsj4x9Hdr2ne94CK2MhOPcoKi74GhE",
        "range": "재고!A1:D1000"
      }
    },
    {
      "id": "filter",
      "name": "부족 재고 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const shortages = $input.all()\n  .map(item => item.json)\n  .filter(row => row.rowIndex > 0 && Array.isArray(row.values))\n  .map(row => {\n    const [sku, name, quantityText, thresholdText] = row.values;\n    const quantity = Number(quantityText);\n    const threshold = Number(thresholdText);\n    return {sku: String(sku || ''), name: String(name || ''), quantity, threshold, deficit: threshold - quantity};\n  })\n  .filter(row => row.sku && row.name && Number.isFinite(row.quantity) && Number.isFinite(row.threshold) && row.deficit > 0);\nif (shortages.length === 0) return [];\nconst date = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);\nconst rows = shortages.map(row => [date, row.sku, row.name, row.quantity, row.threshold, row.deficit]);\nconst message = '*재고 부족 알림* (' + date + ')\\n' + shortages.map(row =>\n  '• ' + row.name + ' (' + row.sku + '): 현재 ' + row.quantity + ' / 기준 ' + row.threshold + ' · 부족 ' + row.deficit\n).join('\\n');\nreturn [{json: {rows, message, count: shortages.length}, pairedItem: {item: 0}}];"
      }
    },
    {
      "id": "append",
      "name": "부족 재고 기록",
      "type": "easyflow.googleSheets",
      "typeVersion": 1,
      "position": [
        875,
        210
      ],
      "parameters": {
        "operation": "append",
        "spreadsheetId": "1MU0Y8jy7Ot3sXjsj4x9Hdr2ne94CK2MhOPcoKi74GhE",
        "range": "부족재고_기록!A:F",
        "values": "={{ $json.rows }}",
        "valueInputOption": "RAW"
      }
    },
    {
      "id": "slack",
      "name": "Slack 알림 보내기",
      "type": "n8n-nodes-base.slack",
