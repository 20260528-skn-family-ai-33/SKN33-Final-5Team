# Copy to .env.aws on the EC2 host, restrict access with chmod 600, and replace the placeholders.
# Run with: docker compose --env-file .env.aws up -d --build
# Terminate HTTPS on an EC2 reverse proxy that forwards the original Host to 127.0.0.1:3030.
A4B_DOCKER_PORT=3030
EASYFLOW_PUBLIC_URL=https://app.example.com
A4B_AUTH_MODE=cognito
A4B_COGNITO_USER_POOL_ID=ap-northeast-2_POOL_ID
A4B_COGNITO_CLIENT_ID=CLIENT_ID
A4B_COGNITO_DOMAIN=https://YOUR_DOMAIN.auth.ap-northeast-2.amazoncognito.com
A4B_AUTH_USER_STORE=postgres
A4B_DATABASE_URL='postgresql://APP_USER:URL_ENCODED_PASSWORD@RDS_HOST:5432/a4b_db'
# Copy the AWS RDS CA bundle to the a4b-data volume at this path before starting.
A4B_DATABASE_CA_FILE=/app/data/global-bundle.pem
# Agent-builder business data in the same RDS (a4b_builder schema). Apply the migrations first:
# scripts/deploy/apply-builder-migrations.py with an admin A4B_MIGRATION_DATABASE_URL (docs/business-data-storage.md).
A4B_STORAGE=postgres
# Worker processes per server; each holds up to 2 RDS connections. Sum over all servers
# ((general + control) x 2 + 5 member-store connections) must stay under RDS max_connections.
A4B_WORKER_MAX_CONCURRENCY=12
A4B_WORKER_CONTROL_CONCURRENCY=4

# Use the HTTPS endpoints of the authenticated RunPod services.
# Ollama verifier uses the server root. An OpenAI-compatible vLLM verifier uses /v1.
A4B_MAIN_PROVIDER=ollama
A4B_PLANNER_MODE=direct
A4B_PLANNER_PROMPT=v8
A4B_MAIN_BASE_URL=https://YOUR_POD_ID-11434.proxy.runpod.net/v1
A4B_MAIN_API_KEY='REPLACE_WITH_GATEWAY_TOKEN'
# Matches scripts/start-runpod-qwen-parser.sh and its registered 4B/16K model.
# For separately prepared 9B models, layer .env.aws.qwen35-9b.example as documented in
# docs/a4b-automatic-deployment.md. The default startup script does not install those models.
A4B_MAIN_MODEL=a4b-qwen35-4b-16k
# Blank capability model uses the main model; no second model is required by default.
A4B_CAPABILITY_MODE=enforce
A4B_CAPABILITY_MODEL=
# Native /api/chat context. For /v1, register the model with the same num_ctx in its Modelfile.
A4B_OLLAMA_NUM_CTX=16384
# Blank limits preserve defaults, including DeepAgent's 4096 -> 8192 recovery.
# An explicit NUM_PREDICT is a hard ceiling; 4096 prevents a longer recovery request.
A4B_OLLAMA_NUM_PREDICT=
A4B_OLLAMA_TEMPERATURE=
A4B_VERIFIER_PROVIDER=ollama
A4B_VERIFIER_BASE_URL=https://YOUR_POD_ID-11434.proxy.runpod.net
A4B_VERIFIER_API_KEY='REPLACE_WITH_GATEWAY_TOKEN'
A4B_VERIFIER_MODEL=qwen3.5:4b
A4B_VERIFIER_MODE=shadow

# Private object storage for authenticated workspaces. The EC2 role supplies credentials.
A4B_S3_BUCKET=a4b-documents-20261019-f7c9a2
AWS_REGION=ap-northeast-2

# Optional GPU layout/OCR service on the same Pod.
# A4B_PARSER_URL=https://YOUR_POD_ID-8100.proxy.runpod.net
# A4B_PARSER_API_KEY=REPLACE_WITH_PARSER_TOKEN
# A4B_PARSER_FALLBACK=cpu
