# Opt-in validation profile from the 2026-11-10 service handoff.
# Apply after .env.aws and .env.aws.qwen35-9b; this file does not configure hosts or credentials.
# This is a separate design-policy change, not an automatic consequence of replacing weights.
# Validate your own conversations/workflows before copying these values into env-overrides.
A4B_PLANNER_MODE=deepagent
A4B_REQUIREMENT_MODE=enforce
A4B_REQUIREMENT_GENERATION_MODE=baseline
A4B_CAPABILITY_MODE=enforce
A4B_CONDITION_MODE=enforce
A4B_TOOL_CATALOG_MODE=model
A4B_TOOL_ADVICE_MODE=hint
A4B_TOOL_ADVICE_BACKEND=svm56
A4B_MAIN_TIMEOUT_S=180
A4B_VERIFIER_MODE=shadow
A4B_VERIFIER_MODEL=qwen3.5:4b
# Current defaults: design seed 42, binding repair off. Keep the checked SVM bundle mounted.
# Planner prompt version is a direct-only setting and is not used by DeepAgent.
