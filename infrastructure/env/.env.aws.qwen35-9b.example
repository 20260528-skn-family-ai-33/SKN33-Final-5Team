# Optional model-only overrides for an ALREADY PREPARED Qwen 3.5 9B fine-tuned deployment.
# The repository's default RunPod startup installs 4B, not these private fine-tuned models.
# Preparation and validation: docs/a4b-automatic-deployment.md (9B model configuration).
# Copy this to .env.aws.qwen35-9b after completing the registration/inference checks.
# Keep endpoints, credentials and AWS settings in .env.aws; apply this file second:
# docker compose --env-file .env.aws --env-file .env.aws.qwen35-9b up -d --build
A4B_MAIN_PROVIDER=ollama
A4B_PLANNER_MODE=deepagent
# Disable the optional 4B shadow/deferred reviewer; native validation still runs.
A4B_VERIFIER_MODE=off
A4B_MAIN_MODEL=a4b-qwen35-9b-final664-pilot32k
# Explicitly route old local 4B sessions/workflows to final664 without rewriting saved data.
# Includes the equivalent :latest tag. Remove this setting only after restoring the old model.
A4B_OLLAMA_MODEL_ALIASES='{"a4b-qwen35-4b-16k":"a4b-qwen35-9b-final664-pilot32k"}'
A4B_CAPABILITY_MODE=enforce
A4B_CAPABILITY_MODEL=a4b-qwen35-9b-previous-pilot32k
# Native /api/chat context. /v1 also requires num_ctx=32768 in each registered Modelfile.
A4B_OLLAMA_NUM_CTX=32768
# Hard ceiling for both initial calls and retries. Choose 8192 only if the deployment permits
# longer DeepAgent recovery; with 4096 the app reports the limit without repeating the call.
A4B_OLLAMA_NUM_PREDICT=4096
A4B_OLLAMA_TEMPERATURE=0
