# Model-only overlay for the ALREADY REGISTERED fine-tuned 9B models on EC2.
# Keep A4B_MAIN_BASE_URL, credentials and all other deployment settings in .env.aws.
# MAIN_BASE_URL must be reachable FROM the app container and end in /v1.
# docker compose --env-file .env.aws --env-file .env.ec2.qwen35-9b config --quiet
# docker compose --env-file .env.aws --env-file .env.ec2.qwen35-9b up -d --build
# For Actions/Docker --env-file, see docs/a4b-automatic-deployment.md; copying this
# example into Git alone does not update an existing EC2 container's environment.
A4B_SHARED_MODEL_TARGET=ec2
A4B_MAIN_PROVIDER=ollama
A4B_MAIN_MODEL=a4b-qwen35-9b-final664-pilot32k
A4B_LLM_MODEL=a4b-qwen35-9b-final664-pilot32k
A4B_CAPABILITY_MODE=enforce
A4B_CAPABILITY_MODEL=a4b-qwen35-9b-previous-pilot32k
A4B_OLLAMA_MODEL_ALIASES='{"a4b-qwen35-4b-16k":"a4b-qwen35-9b-final664-pilot32k"}'
A4B_OLLAMA_NUM_CTX=32768
A4B_OLLAMA_NUM_PREDICT=4096
A4B_OLLAMA_TEMPERATURE=0
# Planner mode/prompt, requirement validation and verifier are intentionally not
# overridden here: changing a model connection must not change the design path.
