{
  "//": "Runtime alias for tsx when commands run from the repository root (tests import screen modules that use @/). Type checks use Frontend/ and Backend/api/ tsconfig files.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./Frontend/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "Frontend/**/*.ts",
    "Frontend/**/*.tsx",
    "shared/**/*.ts",
    "Backend/api/**/*.ts",
    "scripts/verify/api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist-app",
    "**/build-server"
  ]
}
